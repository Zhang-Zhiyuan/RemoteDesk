* text=auto

# Shell entry points must also work when cloned on Windows and run in WSL.
*.sh text eol=lf
*.py text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Preserve the pinned upstream shader/license formatting, including its few
# trailing comment spaces. Local adapters and tests remain whitespace-checked.
src/RemoteDesk/ThirdParty/NIS/* text eol=lf whitespace=-blank-at-eol

# Bundled assets and the Gradle wrapper are binary.
*.png binary
*.ico binary
*.jar binary
*.exe binary
*.apk binary
*.deb binary
*.tar.gz binary
*.zip binary
