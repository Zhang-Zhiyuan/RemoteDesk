<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Isolated, opt-in API probe. No Internet or production data access. -->
    <application android:label="RemoteDesk Lock Test" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".CaptureReceiver" android:exported="true" />
        <service android:name=".ScreenshotService" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
